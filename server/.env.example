PORT=3001
MONGO_URL=mongodb://127.0.0.1:27017/mytracker
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# Папки на сервере: каждый проект лежит в $REPOS_DIR/<project>
REPOS_DIR=/srv/repos
WORKTREES_DIR=/srv/worktrees
DEFAULT_BRANCH=main

# Claude Code CLI (нужно один раз выполнить `claude` и `/login` под пользователем сервиса)
CLAUDE_BIN=claude
# Максимальное время одного запуска Claude, минут
RUN_TIMEOUT_MIN=30
# Адрес API, который увидит Claude внутри skills (по умолчанию из PORT)
TRACKER_API_URL=http://localhost:3001/api

# Telegram (необязательно). Проще подключить бота в интерфейсе: «Настройки» → «Telegram-бот»,
# значения оттуда важнее этих. Бот отвечает только TELEGRAM_OWNER_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# HTTPS-адрес трекера для Mini App (Telegram не открывает http и IP-адреса)
TELEGRAM_MINIAPP_URL=https://tracker.example.com

# Вложения задач (скриншоты) хранятся в MinIO, см. docker-compose.yml
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=mytracker
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=mytracker-attachments

# Хранилище вложений по умолчанию (minio или s3). Выбор можно менять в интерфейсе, вкладка «Настройки»
ATTACHMENT_STORAGE=minio
# S3 в облаке reg.ru: адрес, регион и ключи берутся в панели reg.ru (раздел «Объектное хранилище»)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=mytracker-attachments
