PORT=3001
MONGO_URL=mongodb://127.0.0.1:27017/mytracker
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# Папки на сервере: каждый проект лежит в $REPOS_DIR/<project>
REPOS_DIR=/srv/repos
WORKTREES_DIR=/srv/worktrees
# Основная ветка по умолчанию; у проекта своя задаётся полем «Основная ветка»
DEFAULT_BRANCH=main

# Claude Code CLI (нужно один раз выполнить `claude` и `/login` под пользователем сервиса)
CLAUDE_BIN=claude
# Максимальное время одного запуска Claude, минут
RUN_TIMEOUT_MIN=30
# Папка установки трекера на сервере (по умолчанию на уровень выше server/). Нужна разделу «Сервер»
# OPS_APP_DIR=/srv/mytracker

# GitHub: токен для синхронизации проектов с репозиториями (необязательно). Проще ввести его в интерфейсе:
# «Настройки» → «GitHub», значение оттуда важнее этого. Fine-grained токен:
# доступ к нужным репозиториям, права Contents и Administration на чтение и запись, Metadata на чтение.
# Без токена проекты не создают репозитории и не подтягивают список из GitHub
GITHUB_TOKEN=

# Адрес API, который увидит Claude внутри skills (по умолчанию из PORT)
TRACKER_API_URL=http://localhost:3001/api

# Telegram (необязательно). Проще подключить бота в интерфейсе: «Настройки» → «Telegram-бот»,
# значения оттуда важнее этих. Бот отвечает только TELEGRAM_OWNER_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# HTTPS-адрес трекера для Mini App (Telegram не открывает http и IP-адреса)
TELEGRAM_MINIAPP_URL=https://tracker.example.com

# Вложения задач (скриншоты) хранятся на диске в этой папке. По умолчанию uploads/ рядом с server/
# ATTACHMENTS_DIR=
